# Python 字节码与测试缓存
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Qt / qmake 构建产物
QtChartWidget/bin/
QtChartWidget/build/
_qt_*/release/
_qt_*/debug/
_qt_*/build/
_qt_*/Makefile*
_qt_*/.qmake.stash

# 离线分发包
*.zip
dist/

# 会话导出产物（运行时生成，避免被打包进离线包）
exports/

# IDE / 工具临时产物
.superpowers/
_qt_float_demo/float_demo.pro
_qt_float_demo/main.cpp
_qt_float_demo/shot_float_after_resize.png
_qt_float_demo/shot_float_final.png
_qt_float_demo/shot_float_start.png
_qt_float_demo/shot_main_after_resize.png
